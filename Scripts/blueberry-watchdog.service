[Unit]
Description=Blueberry Vault Watchdog
After=network.target

[Service]
User=mainberry
WorkingDirectory=/home/mainberry/Blueberry
EnvironmentFile=/home/mainberry/Blueberry/Configs/.env
ExecStart=/home/mainberry/Blueberry/.venv/bin/python /home/mainberry/Blueberry/watchdog_daemon.py
Restart=always
RestartSec=10
StandardOutput=append:/home/mainberry/Logs/watchdog.log
StandardError=append:/home/mainberry/Logs/watchdog.log

[Install]
WantedBy=multi-user.target
