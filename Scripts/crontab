# At every 5th minute
# For periodic mail checking
*/5 * * * * /usr/bin/flock -n /tmp/blueberry.lock -c "/home/mainberry/Dev/Scripts/LoadEnv.sh /home/mainberry/Dev/MailServer/fetch.py"

# At every 10th minute
# For periodic mail response
*/10 * * * * /usr/bin/flock -n /tmp/blueberry.lock -c "/home/mainberry/Dev/Scripts/LoadEnv.sh /home/mainberry/Dev/MailServer/reply.py"

# At 8 am every other day
# For proactive check-ins
0 8 */2 * * /usr/bin/flock -n /tmp/blueberry.lock -c "/home/mainberry/Dev/Scripts/LoadEnv.sh /home/mainberry/Dev/MailServer/proactive_checkin.py"

# At 07:01
# For daily summary
1 7 * * * /usr/bin/flock -n /tmp/blueberry.lock -c "/home/mainberry/Dev/Scripts/LoadEnv.sh /home/mainberry/Dev/LLM/summarize.py daily"

# At 23:01 on Sunday
# For weekly summary
1 23 * * 0 /usr/bin/flock -n /tmp/blueberry.lock -c "/home/mainberry/Dev/Scripts/LoadEnv.sh /home/mainberry/Dev/LLM/summarize.py weekly"

# At 00:01 on day-of-month 1
# For monthly summary
1 0 1 * * /usr/bin/flock -n /tmp/blueberry.lock -c "/home/mainberry/Dev/Scripts/LoadEnv.sh /home/mainberry/Dev/LLM/summarize.py monthly"

# At 01:01 on day-of-month 1 in every 3rd month
# For quarterly summary
1 1 1 */3 * /usr/bin/flock -n /tmp/blueberry.lock -c "/home/mainberry/Dev/Scripts/LoadEnv.sh /home/mainberry/Dev/LLM/summarize.py quarterly"
